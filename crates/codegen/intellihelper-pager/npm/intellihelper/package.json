{
    "name": "@intellihelper/cli",
    "version": "0.1.1",
    "description": "Bring IntelliHelper into your terminal",
    "license": "Apache-2.0",
    "bin": {
        "intelli": "bin/intelli",
        "intellihelper": "bin/intelli"
    },
    "files": [
        "bin/"
    ],
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "cpu": [
        "arm64",
        "x64"
    ],
    "scripts": {
        "postinstall": "node bin/postinstall.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@iarna/toml": "^3.0.0"
    },
    "optionalDependencies": {
        "@intellihelper/cli-darwin-arm64": "0.1.220-alpha.4",
        "@intellihelper/cli-darwin-x64": "0.1.220-alpha.4",
        "@intellihelper/cli-linux-arm64": "0.1.220-alpha.4",
        "@intellihelper/cli-linux-x64": "0.1.220-alpha.4",
        "@intellihelper/cli-win32-arm64": "0.1.220-alpha.4",
        "@intellihelper/cli-win32-x64": "0.1.220-alpha.4"
    }
}
